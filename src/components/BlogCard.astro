---
import Separator from '@/components/Separator.astro'
import { ICONS } from '@/consts'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
  formatReadingTime,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTimeMinutes = await getCombinedReadingTime(entry.id)
const readTime = formatReadingTime(readTimeMinutes)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry) ? await getSubpostCount(entry.id) : 0
---

<div
  class="group relative overflow-hidden rounded-xl border border-border/60 bg-card/60 p-4 transition-all duration-300 hover:border-primary/40 hover:bg-card hover:shadow-sm dark:bg-transparent dark:hover:bg-muted/30"
>
  <div
    class="from-primary/0 via-primary/0 to-primary/0 group-hover:from-primary/5 absolute inset-0 -z-10 bg-gradient-to-br opacity-0 transition-opacity duration-500 group-hover:to-purple-500/5 group-hover:opacity-100"
  >
  </div>
  <div class="flex flex-col gap-4 sm:flex-row">
    <a href={`/${entry.collection}/${entry.id}`} class="absolute inset-0 z-10">
      <span class="sr-only">Read {entry.data.title}</span>
    </a>
    {
      entry.data.image && (
        <div class="aspect-[1200/630] w-full overflow-hidden rounded-lg sm:max-w-3xs sm:shrink-0 sm:self-start">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            widths={[400, 800, 1200]}
            sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px"
            width={1200}
            height={630}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-1 text-lg font-medium">{entry.data.title}</h3>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <Image
                    src={author.avatar}
                    alt={author.name}
                    width={16}
                    height={16}
                    class="bg-muted rounded-full object-cover"
                  />
                  <span>{author.name}</span>
                </div>
              ))}
              <Separator orientation="vertical" class="h-4!" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <Separator orientation="vertical" class="h-4!" />
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" class="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name={ICONS.fileText} class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class="border-primary/10 dark:border-primary/20 bg-primary/5 dark:bg-primary/10 text-primary hover:bg-primary/10 dark:hover:bg-primary/20 relative z-20 flex items-center gap-x-1 rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors"
              >
                <Icon name={ICONS.hash} class="size-3" />
                {tag}
              </a>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
