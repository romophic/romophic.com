---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'

import Layout from '@/layouts/Layout.astro'
import { groupPostsByYear } from '@/lib/data-utils'
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props

const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Blog" />

  <div
    class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-8"
    id="blog-list-container"
  >
    {
      years.map((year) => (
        <section class="blog-year-section flex flex-col gap-y-4">
          <div class="font-medium">{year}</div>
          <ul class="flex flex-col gap-4">
            {postsByYear[year].map((post) => (
              <li
                class="blog-post-item"
                data-tags={post.data.tags?.join(',') || ''}
              >
                <BlogCard entry={post} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <div class="mt-8 flex items-center justify-center gap-4">
    {
      page.url.prev && (
        <a
          href={page.url.prev}
          class="border-border hover:bg-muted/50 rounded-md border px-4 py-2 transition-colors"
        >
          ← Previous
        </a>
      )
    }
    <span class="text-muted-foreground text-sm">
      Page {page.currentPage} of {page.lastPage}
    </span>
    {
      page.url.next && (
        <a
          href={page.url.next}
          class="border-border hover:bg-muted/50 rounded-md border px-4 py-2 transition-colors"
        >
          Next →
        </a>
      )
    }
  </div>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const params = new URLSearchParams(window.location.search)
    const tagToFilter = params.get('tag')

    if (tagToFilter) {
      const posts = document.querySelectorAll('.blog-post-item')
      const sections = document.querySelectorAll('.blog-year-section')

      posts.forEach((post) => {
        const tagsString = post.getAttribute('data-tags')
        const tags = tagsString ? tagsString.split(',') : []
        if (tags.includes(tagToFilter)) {
          ;(post as HTMLElement).style.display = 'block'
        } else {
          ;(post as HTMLElement).style.display = 'none'
        }
      })

      // Hide empty year sections
      sections.forEach((section) => {
        const visiblePosts = Array.from(
          section.querySelectorAll('.blog-post-item'),
        ).filter((p) => (p as HTMLElement).style.display !== 'none')
        if (visiblePosts.length === 0) {
          ;(section as HTMLElement).style.display = 'none'
        }
      })
    }
  })
</script>
