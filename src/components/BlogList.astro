---
import BlogCard from '@/components/BlogCard.astro'
import PageHead from '@/components/PageHead.astro'
import Search from 'astro-pagefind/components/Search.astro'

import Layout from '@/layouts/Layout.astro'
import { groupPostsByYear } from '@/lib/data-utils'
import { pluralize } from '@/lib/utils'
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

interface Props {
  page: Page<CollectionEntry<'blog'>>
  currentTag?: string
}

const { page, currentTag } = Astro.props

const postsByYear = groupPostsByYear(page.data)
const years = Object.keys(postsByYear).sort((a, b) => parseInt(b) - parseInt(a))
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title={currentTag
      ? `Tag: ${currentTag}${page.currentPage > 1 ? ` - Page ${page.currentPage}` : ''}`
      : page.currentPage > 1
        ? `Blog - Page ${page.currentPage}`
        : 'Blog'}
    description={currentTag
      ? `Page ${page.currentPage} of posts tagged with ${currentTag}`
      : `Page ${page.currentPage} of all blog posts`}
  />

  <div class="pagefind-search pt-1">
    <Search
      className="pagefind-ui w-full"
      searchboxOptions={{ 'show-sub-results': true }}
    />
  </div>

  <div
    class="flex min-h-[calc(100vh-18rem)] flex-col gap-y-8"
    id="blog-list-container"
  >
    {
      currentTag && (
        <header class="flex flex-col gap-4">
          <h1 class="text-3xl font-bold tracking-tight">Tag: {currentTag}</h1>
          <p class="text-muted-foreground">
            {page.data.length} {pluralize(page.data.length, 'post')} tagged with{' '}
            <span class="text-foreground font-semibold">{currentTag}</span>
          </p>
        </header>
      )
    }
    {
      !currentTag && (
        <header class="flex flex-col gap-4">
          <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
        </header>
      )
    }
    {
      years.map((year) => (
        <section class="blog-year-section flex flex-col gap-y-4">
          <div class="font-medium">{year}</div>
          <ul class="flex flex-col gap-4">
            {postsByYear[year].map((post) => (
              <li
                class="blog-post-item"
                data-tags={post.data.tags?.join(',') || ''}
              >
                <BlogCard entry={post} headingLevel={2} />
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <div class="mt-8 flex items-center justify-center gap-4">
    {
      page.url.prev && (
        <a
          href={page.url.prev}
          class="border-border hover:bg-muted/50 rounded-md border px-4 py-2 transition-colors"
        >
          ← Previous
        </a>
      )
    }
    <span class="text-muted-foreground text-sm">
      Page {page.currentPage} of {page.lastPage}
    </span>
    {
      page.url.next && (
        <a
          href={page.url.next}
          class="border-border hover:bg-muted/50 rounded-md border px-4 py-2 transition-colors"
        >
          Next →
        </a>
      )
    }
  </div>
</Layout>
