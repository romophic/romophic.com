---
import Search from 'astro-pagefind/components/Search.astro'
---

<dialog
  id="search-dialog"
  class="glass-card text-foreground open:animate-in open:fade-in-100 open:zoom-in-95 m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl p-0 shadow-lg outline-none overflow-visible backdrop:bg-transparent backdrop:backdrop-blur-sm"
>
  <div class="w-full relative">
    <Search
      className="pagefind-ui w-full"
      searchboxOptions={{
        'show-sub-results': true,
        'show-images': false,
      }}
    />
  </div>
</dialog>

<script>
  document.addEventListener('astro:page-load', () => {
    const dialog = document.getElementById(
      'search-dialog',
    ) as HTMLDialogElement | null
    if (!dialog) return

    window.toggleCommandMenu = () => {
      if (dialog.open) {
        dialog.close()
      } else {
        dialog.showModal()
        // Focus input
        setTimeout(() => {
          const input = dialog.querySelector('input')
          if (input) input.focus()
        }, 50)
      }
    }

    const handleKeydown = (e: KeyboardEvent) => {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault()
        if (window.toggleCommandMenu) window.toggleCommandMenu()
      }
    }
    document.addEventListener('keydown', handleKeydown)

    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', handleKeydown)
      },
      { once: true },
    )

    // Close on backdrop click
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) {
        dialog.close()
      }
    })
  })
</script>

<style is:global>
  /* Customizing pagefind to match dark mode and typography */
  .pagefind-ui {
    width: 100%;
    --pagefind-ui-scale: 0.85;
    --pagefind-ui-primary: color-mix(
      in oklab,
      var(--primary) 50%,
      var(--foreground) 50%
    );
    --pagefind-ui-text: var(--foreground);
    --pagefind-ui-background: var(--background);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: color-mix(in oklab, var(--primary) 20%, transparent);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 6px;
    --pagefind-ui-image-border-radius: 6px;
    --pagefind-ui-font: var(--font-sans);
  }

  .pagefind-ui .pagefind-ui__search-input {
    font-weight: normal;
    background-color: var(--background);
    border-radius: var(--radius);
  }

  .pagefind-ui .pagefind-ui__drawer {
    position: absolute !important;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 9999 !important;
    margin-top: 0.5rem;
    background-color: var(--background);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.1),
      0 8px 10px -6px rgba(0, 0, 0, 0.1);
    max-height: 60vh;
    overflow-y: auto !important;
    padding: 1rem;
  }

  /* 検索結果がない時や初期状態のボーダーやパディングを微調整 */
  .pagefind-ui .pagefind-ui__drawer:empty {
    display: none;
  }

  .pagefind-ui .pagefind-ui__result-excerpt mark {
    background-color: color-mix(in oklab, var(--primary) 20%, transparent);
    color: var(--foreground);
    font-weight: 600;
  }

  .pagefind-ui .pagefind-ui__result-title,
  .pagefind-ui .pagefind-ui__result-link {
    color: var(--foreground);
    font-weight: 500;
  }
</style>
