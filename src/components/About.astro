---
import PageHead from '@/components/PageHead.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import { ICON_MAP, ICONS, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

import TechBadge from '@/components/TechBadge.astro'
import TimelineItem from '@/components/TimelineItem.astro'
import { TECH_BADGES } from '@/lib/tech-badges'
const projects = await getAllProjects()

const TECH_STACK = Object.keys(TECH_BADGES)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="About" />

  <section class="space-y-12">
    {/* Page Title */}
    <div>
      <h1 class="text-3xl font-bold tracking-tight">About</h1>
    </div>

    {/* Career */}
    <div>
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Career</h2>
      <div class="border-muted relative ml-2 space-y-8 border-l-2 pl-6">
        {
          [
            {
              title: 'Morgan Stanley',
              period: '2026/08',
              description: 'Technology Intern',
              techs: [],
            },
            {
              title: 'Howtelevision',
              period: '2026/04 - Present',
              description: 'Software Engineer Intern',
              link: '/blog/joined-howtv',
              techs: [
                'Ruby on Rails',
                'AWS',
                'Next.js',
                'Nuxt.js',
                'React Native',
                'Docker',
              ],
            },
            {
              title: 'Goldman Sachs',
              period: '2025/09',
              description: 'Engineering Workshop',
              techs: ['Python'],
            },
          ].map((item) => <TimelineItem {...item} />)
        }
      </div>
    </div>

    {/* Education */}
    <div>
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Education</h2>
      <div class="border-muted relative ml-2 space-y-8 border-l-2 pl-6">
        {
          [
            {
              title: 'Institute of Science Tokyo (Tokyo Tech)',
              period: '2024/04 - Present',
              description: 'B.Eng Electrical and Electronic Engineering',
            },
            {
              title: 'UTokyoGSC 4期',
              period: '2021 - 2024',
              description:
                '制約付き筋肉トレーニングにおける負荷効果最大化に関する数理モデル研究',
              techs: ['Python'],
            },
          ].map((item) => <TimelineItem {...item} />)
        }
      </div>
    </div>

    {/* Awards */}
    <div>
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Awards</h2>
      <div class="border-muted relative ml-2 space-y-8 border-l-2 pl-6">
        {
          [
            {
              title: 'ICPC Yokohama Regional Awarded',
              period: '2024/07',
              description: '',
              link: 'https://trap.jp/post/2277/',
              techs: ['C++'],
            },
            {
              title: 'JOI本選',
              period: '2020, 2022',
              description: '',
              techs: ['C++'],
            },
          ].map((item) => <TimelineItem {...item} />)
        }
      </div>
    </div>

    {/* Tech Stack */}
    <div>
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Tech Stack</h2>
      <div class="flex flex-wrap gap-2">
        {
          TECH_STACK.map((tech) => (
            <TechBadge
              tech={tech}
              class="hover:bg-opacity-80 px-3 py-1 text-sm"
            />
          ))
        }
      </div>
    </div>

    {/* Connect */}
    <div>
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Connect</h2>
      <div class="flex flex-wrap gap-4">
        {
          SOCIAL_LINKS.map((social) => (
            <a
              href={social.href}
              class="text-muted-foreground hover:text-foreground hover:bg-muted flex items-center gap-2 rounded-md p-2 transition-colors"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon
                name={
                  (ICON_MAP as Record<string, string>)[social.label] ||
                  ICONS.link
                }
                class="size-5"
              />
              <span class="font-medium">{social.label}</span>
            </a>
          ))
        }
      </div>
    </div>

    {/* Projects */}
    <div>
      <h2 class="mb-6 text-2xl font-semibold tracking-tight">Projects</h2>
      <div class="flex flex-col gap-4">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</Layout>
