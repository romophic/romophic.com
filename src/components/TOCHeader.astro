---
import { ICONS } from '@/consts'
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'

type Props = { headings: MarkdownHeading[] }
const { headings } = Astro.props
---

<mobile-toc
  class="liquid-glass border-b group sticky top-14 z-40 block w-full md:hidden"
>
  <details
    class="[&>summary::marker]:hidden"
    id="mobile-toc-details"
    data-toc-details
  >
    <summary
      class="focus-visible:ring-ring flex h-12 cursor-pointer items-center justify-between px-4 outline-none focus-visible:ring-2 focus-visible:ring-inset"
    >
      <div class="flex items-center gap-2 overflow-hidden">
        <svg class="h-4 w-4" viewBox="0 0 24 24">
          <circle
            class="text-primary/20"
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></circle>
          <circle
            id="mobile-toc-progress-circle"
            class="text-primary"
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-dasharray="62.83"
            stroke-dashoffset="62.83"
            transform="rotate(-90 12 12)"></circle>
        </svg>

        <span
          id="mobile-toc-current-section"
          class="text-muted-foreground flex-grow truncate text-sm"
        >
          Overview
        </span>
      </div>
      <span class="text-muted-foreground ml-2">
        <Icon
          name={ICONS.chevronDown}
          class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
        />
      </span>
    </summary>
    <div
      class="mx-auto max-w-3xl overflow-x-hidden overflow-y-auto overscroll-contain"
      data-toc-header-scroll
    >
      <div class="max-h-[30vh]">
        <ul
          class="flex list-none flex-col gap-y-2 px-4 pb-4"
          id="mobile-table-of-contents"
        >
          {
            headings.map((heading: MarkdownHeading) => (
              <li
                class={`text-sm tracking-wide ${
                  heading.depth === 2
                    ? 'text-foreground mt-4 font-semibold'
                    : 'text-muted-foreground ml-3'
                }`}
              >
                {' '}
                <a
                  href={`#${heading.slug}`}
                  class="mobile-toc-item underline decoration-transparent underline-offset-[3px] transition-colors duration-200 hover:decoration-inherit"
                  data-heading-id={heading.slug}
                >
                  {' '}
                  {heading.text}{' '}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <script>
      import { getPageScrollProgress, observeActiveHeadings } from '@/lib/scroll-utils'

      const INITIAL_OVERVIEW_TEXT = 'Overview'
      const PROGRESS_CIRCLE_RADIUS = 10
      const PROGRESS_CIRCLE_CIRCUMFERENCE = 2 * Math.PI * PROGRESS_CIRCLE_RADIUS

      class MobileTOC extends HTMLElement {
        private onScroll: (() => void) | null = null
        private observer: IntersectionObserver | null = null

        connectedCallback() {
          const progressCircle = this.querySelector(
            '#mobile-toc-progress-circle',
          ) as HTMLElement
          const currentSectionText = this.querySelector(
            '#mobile-toc-current-section',
          ) as HTMLElement
          const detailsElement = this.querySelector('details')
          const scrollArea = this.querySelector(
            '[data-toc-header-scroll]',
          ) as HTMLElement | null

          if (progressCircle) {
            progressCircle.style.strokeDasharray =
              PROGRESS_CIRCLE_CIRCUMFERENCE.toString()
            progressCircle.style.strokeDashoffset =
              PROGRESS_CIRCLE_CIRCUMFERENCE.toString()
          }

          // Progress circle update
          this.onScroll = () => {
            if (!progressCircle) return
            progressCircle.style.strokeDashoffset = (
              PROGRESS_CIRCLE_CIRCUMFERENCE *
              (1 - getPageScrollProgress())
            ).toString()
          }
          window.addEventListener('scroll', this.onScroll, { passive: true })

          // Close on link click
          this.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
              if (detailsElement) detailsElement.open = false
            })
          })

          // Intersection Observer for active heading
          this.observer = observeActiveHeadings({
            linkAttribute: 'data-heading-id',
            scrollArea,
            scope: this,
            onActive: (link) => {
              if (currentSectionText) {
                currentSectionText.textContent =
                  link.textContent?.trim() || INITIAL_OVERVIEW_TEXT
              }
            },
          })
        }

        disconnectedCallback() {
          if (this.onScroll) {
            window.removeEventListener('scroll', this.onScroll)
            this.onScroll = null
          }
          this.observer?.disconnect()
          this.observer = null
        }
      }

      customElements.define('mobile-toc', MobileTOC)
    </script>
  </details>
</mobile-toc>
