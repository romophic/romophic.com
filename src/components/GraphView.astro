---
// src/components/GraphView.astro

interface Props {
  class?: string
  fullInteraction?: boolean
}

const {
  class:
    className = 'bg-background relative h-[600px] w-full rounded-lg border',
  fullInteraction = true,
} = Astro.props
---

<div
  id="graph-container"
  data-full-interaction={fullInteraction.toString()}
  class={`overflow-hidden opacity-0 transition-opacity duration-100 ${className}`}
>
  <canvas
    id="graph-canvas"
    class={`block ${fullInteraction ? 'cursor-move' : ''}`}></canvas>
</div>

<script>
  import { GraphViewManager } from '@/lib/graph/manager'

  let manager: GraphViewManager | null = null
  let pendingInit: { kind: 'idle' | 'timeout'; id: number } | null = null

  const cancelPendingInit = () => {
    if (!pendingInit) return
    if (pendingInit.kind === 'idle') cancelIdleCallback(pendingInit.id)
    else clearTimeout(pendingInit.id)
    pendingInit = null
  }

  const init = () => {
    pendingInit = null
    if (!document.getElementById('graph-container')) return
    manager?.destroy()
    manager = new GraphViewManager('graph-container', 'graph-canvas')
  }

  // Initialize when the DOM is ready and during Astro view transitions
  document.addEventListener('astro:page-load', () => {
    if (!document.getElementById('graph-container')) return

    // Delay initialization until the main thread is idle (improves LCP/TTI)
    if (typeof requestIdleCallback === 'function') {
      pendingInit = {
        kind: 'idle',
        id: requestIdleCallback(init, { timeout: 2000 }),
      }
    } else {
      pendingInit = { kind: 'timeout', id: window.setTimeout(init, 1) }
    }
  })

  // Tear the graph down before the page is swapped out (view transitions)
  document.addEventListener('astro:before-swap', () => {
    cancelPendingInit()
    manager?.destroy()
    manager = null
  })
</script>
