---
// src/components/features/GraphView.astro

interface Props {
  class?: string
  fullInteraction?: boolean
}

const {
  class:
    className = 'bg-background relative h-[600px] w-full rounded-lg border',
  fullInteraction = true,
} = Astro.props
---

<div
  id="graph-container"
  data-full-interaction={fullInteraction.toString()}
  class={`overflow-hidden opacity-0 transition-opacity duration-100 ${className}`}
>
  <canvas
    id="graph-canvas"
    class={`block ${fullInteraction ? 'cursor-move' : ''}`}></canvas>
</div>

<script>
  import { GraphViewManager } from '@/lib/graph/manager'

  // Initialize when the DOM is ready and during Astro view transitions
  document.addEventListener('astro:page-load', () => {
    if (document.getElementById('graph-container')) {
      const initGraph = () =>
        new GraphViewManager('graph-container', 'graph-canvas')

      // Delay initialization until the main thread is idle (improves LCP/TTI)
      if ('requestIdleCallback' in window) {
        requestIdleCallback(initGraph, { timeout: 2000 })
      } else {
        setTimeout(initGraph, 1)
      }
    }
  })
</script>
