---
// src/components/scripts/AppScript.astro
// Central manager for theme and global scripts across transitions (astro:page-load).
---

<script is:inline>
  // Immediate theme initialization to prevent FOUC
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme')
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark'
    }
    return 'light'
  }

  const applyTheme = () => {
    if (getTheme() === 'dark') {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }
  }

  applyTheme()

  // Ensure the theme class is preserved during View Transitions
  document.addEventListener('astro:before-swap', (ev) => {
    const currentTheme = getTheme()
    if (currentTheme === 'dark') {
      ev.newDocument.documentElement.classList.add('dark')
    }
  })
</script>

<script>
  // Bundled script to register the <giscus-widget> custom element natively
  import 'giscus'
</script>
