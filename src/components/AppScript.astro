---
// src/components/AppScript.astro
// Immediate theme bootstrap and propagation across view transitions.
---

<script is:inline>
  // Immediate theme initialization to prevent FOUC
  const getTheme = () => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme')
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark'
    }
    return 'light'
  }

  const applyTheme = () => {
    if (getTheme() === 'dark') {
      document.documentElement.classList.add('dark')
    } else {
      document.documentElement.classList.remove('dark')
    }
  }

  applyTheme()

  // Keep the theme class across View Transitions: the router swaps in the new
  // document before the location changes, so propagate the stored preference
  // here instead of waiting for astro:page-load.
  document.addEventListener('astro:before-swap', (ev) => {
    if (getTheme() === 'dark') {
      ev.newDocument.documentElement.classList.add('dark')
    }
  })
</script>
