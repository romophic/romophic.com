---
import { ICONS } from '@/consts'
import { getSubpostsData } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'
import SubpostItem from './SubpostItem.astro'

interface Props {
  parentId: string
}

const { parentId } = Astro.props
const currentPostId = Astro.params.id as string

const {
  activePost,
  isActivePost,
  activePostReadingTime,
  activePostCombinedReadingTime,
  subpostsWithReadingTime,
  currentSubpostDetails,
} = await getSubpostsData(parentId, currentPostId)
---

{
  activePost && subpostsWithReadingTime.length > 0 && (
    <mobile-subposts
      id="mobile-subposts-container"
      class="block w-full xl:hidden"
    >
      <details class="group">
        <summary class="flex w-full cursor-pointer items-center justify-between">
          <div class="mx-auto flex w-full max-w-3xl items-center px-4 py-3">
            <div class="relative mr-2 size-4">
              <Icon
                name={
                  currentSubpostDetails
                    ? ICONS.fileText
                    : isActivePost
                      ? ICONS.bookOpenText
                      : ICONS.bookOpen
                }
                class="size-4 flex-shrink-0"
                aria-hidden="true"
              />
            </div>
            <div class="flex flex-grow flex-col truncate text-sm">
              <span class="text-muted-foreground truncate">
                {currentSubpostDetails
                  ? currentSubpostDetails.data.title
                  : activePost?.data.title}
              </span>
            </div>
            <span class="text-muted-foreground ml-2">
              <Icon
                name={ICONS.chevronDown}
                class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
              />
            </span>
          </div>
        </summary>

        <div
          class="mx-auto max-w-3xl overflow-x-hidden overflow-y-auto"
          data-subposts-header-scroll
        >
          <div class="max-h-[30vh]">
            <ul class="flex list-none flex-col gap-y-1 px-4 pb-4">
              {activePost && (
                <li>
                  <SubpostItem
                    title={activePost.data.title}
                    href={`/blog/${activePost.id}`}
                    readingTime={activePostReadingTime}
                    combinedReadingTime={activePostCombinedReadingTime}
                    isActive={isActivePost}
                    icon={ICONS.bookOpen}
                    activeIcon={ICONS.bookOpenText}
                    activeClassName="mobile-subposts-active-item"
                    linkClassName="mobile-subposts-link"
                  />
                </li>
              )}

              {subpostsWithReadingTime.length > 0 && (
                <div class="ml-4 space-y-1">
                  {subpostsWithReadingTime.map((subpost) => (
                    <SubpostItem
                      title={subpost.data.title}
                      href={`/blog/${subpost.id}`}
                      readingTime={subpost.readingTime}
                      isActive={currentPostId === subpost.id}
                      icon={ICONS.file}
                      activeIcon={ICONS.fileText}
                      activeClassName="mobile-subposts-active-item"
                      linkClassName="mobile-subposts-link"
                    />
                  ))}
                </div>
              )}
            </ul>
          </div>
        </div>
      </details>
    </mobile-subposts>
  )
}

<script>
  import { scrollToCenter, updateScrollMaskClasses } from '@/lib/scroll-utils'

  class MobileSubposts extends HTMLElement {
    private scrollArea: HTMLElement | null = null
    private detailsElement: HTMLDetailsElement | null = null

    constructor() {
      super()
      this.updateScrollMask = this.updateScrollMask.bind(this)
    }

    connectedCallback() {
      this.init()
    }

    disconnectedCallback() {
      this.scrollArea?.removeEventListener('scroll', this.updateScrollMask)
    }

    init() {
      this.scrollArea = this.querySelector('[data-subposts-header-scroll]')
      this.detailsElement = this.querySelector('details')
      this.setupInteraction()
    }

    updateScrollMask() {
      if (!this.scrollArea) return
      updateScrollMaskClasses(this.scrollArea, this.scrollArea, {
        topClass: 'mask-t-from-80%',
        bottomClass: 'mask-b-from-80%',
      })
    }

    scrollToActive() {
      if (!this.scrollArea) return
      const activeItem = this.scrollArea.querySelector(
        '.mobile-subposts-active-item',
      )
      if (!activeItem) return
      scrollToCenter(this.scrollArea, activeItem as HTMLElement)
    }

    setupInteraction() {
      if (this.scrollArea) {
        this.scrollArea.addEventListener('scroll', this.updateScrollMask, {
          passive: true,
        })
      }

      if (this.detailsElement) {
        this.detailsElement.addEventListener('toggle', () => {
          if (this.detailsElement?.open) {
            requestAnimationFrame(() => {
              this.scrollToActive()
              setTimeout(this.updateScrollMask, 100)
            })
          }
        })
      }

      this.querySelectorAll('.mobile-subposts-link').forEach((link) => {
        link.addEventListener('click', () => {
          if (this.detailsElement) this.detailsElement.open = false
        })
      })
    }
  }

  customElements.define('mobile-subposts', MobileSubposts)
</script>
