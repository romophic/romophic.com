---
import Backlinks from '@/components/Backlinks.astro'
import GiscusComments from '@/components/GiscusComments.astro'
import MdxImageCaption from '@/components/MdxImageCaption.astro'
import PageHead from '@/components/PageHead.astro'
import PostHeader from '@/components/PostHeader.astro'
import PostNavigation from '@/components/PostNavigation.astro'
import ScrollToTop from '@/components/ScrollToTop.astro'
import SubpostsHeader from '@/components/SubpostsHeader.astro'
import TOCHeader from '@/components/TOCHeader.astro'
import TOCSidebar from '@/components/TOCSidebar.astro'
import Layout from '@/layouts/Layout.astro'
import { getOgImageSlug, getParentId, getPostPageData } from '@/lib/data-utils'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const currentPostId = post.id
const inferredParentId = getParentId(post)
const { Content, headings } = await render(post)

const {
  authors,
  isCurrentSubpost,
  navigation,
  hasChildPosts,
  subpostCount,
  postReadingTime,
  combinedReadingTime,
  tocSections,
  backlinks,
} = await getPostPageData(post)

const ogImageUrl = `/og/${getOgImageSlug(post.id, hasChildPosts)}.png`
---

<Layout>
  <PageHead slot="head" post={post} image={ogImageUrl} />
  {
    (hasChildPosts || isCurrentSubpost) && (
      <SubpostsHeader
        slot="subposts-navigation"
        parentId={
          isCurrentSubpost && inferredParentId
            ? inferredParentId
            : currentPostId
        }
      />
    )
  }
  {
    headings?.length > 0 &&
      !(
        isCurrentSubpost &&
        headings.length === 1 &&
        headings[0].text === post.data.title
      ) && <TOCHeader slot="table-of-contents" headings={headings} />
  }

  <section
    class="grid grid-cols-[minmax(0px,1fr)_min(calc(var(--breakpoint-md)-2rem),100%)_minmax(0px,1fr)] gap-y-6"
  >
    <div class="col-start-2"></div>

    {
      post.data.image && (
        <Image
          src={post.data.image}
          alt={post.data.title}
          widths={[400, 800, 1200]}
          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 800px, 1200px"
          width={1200}
          height={630}
          class="col-span-full mx-auto w-full max-w-5xl object-cover"
          transition:name={`image-${post.id}`}
        />
      )
    }

    <PostHeader
      post={post}
      authors={authors}
      postReadingTime={postReadingTime}
      combinedReadingTime={combinedReadingTime}
      subpostCount={subpostCount}
    >
      <PostNavigation
        newerPost={navigation.newer}
        olderPost={navigation.older}
        parentPost={isCurrentSubpost ? navigation.parent : undefined}
      />
    </PostHeader>

    {
      tocSections.length > 0 && (
        <TOCSidebar sections={tocSections} currentPostId={currentPostId} />
      )
    }

    <article class="prose col-start-2 max-w-none">
      <Content
        components={{
          img: MdxImageCaption,
          // Add more standard markdown mappings here in the future:
          // a: CustomLink,
          // blockquote: CustomQuote,
        }}
      />
    </article>

    <div class="col-start-2 max-w-none">
      <Backlinks backlinks={backlinks} />
    </div>

    <div class="col-start-2 max-w-none">
      <GiscusComments />
    </div>

    <PostNavigation
      newerPost={navigation.newer}
      olderPost={navigation.older}
      parentPost={isCurrentSubpost ? navigation.parent : undefined}
    />
  </section>

  <ScrollToTop />
</Layout>
