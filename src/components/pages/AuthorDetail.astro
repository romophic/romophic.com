---
import BlogCard from '@/components/blog/BlogCard.astro'
import AuthorCard from '@/components/common/AuthorCard.astro'
import PageHead from '@/components/layout/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import type { CollectionEntry } from 'astro:content'
import type { Person, WithContext } from 'schema-dts'

interface Props {
  author: CollectionEntry<'authors'>
  authorPosts: CollectionEntry<'blog'>[]
}

const { author, authorPosts } = Astro.props

const personSchema: WithContext<Person> = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.data.name,
  description: author.data.bio,
  image: new URL(author.data.avatar, Astro.site).toString(),
  url: Astro.url.toString(),
}
---

<Layout class="max-w-3xl">
  <PageHead
    slot="head"
    title={`${author.data.name} (Author)`}
    description={author.data.bio || `Profile of ${author.data.name}.`}
    noindex
  />
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(personSchema)}
  />

  <section>
    <AuthorCard author={author} />
  </section>
  <section class="mt-8 flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Posts by {author.data.name}</h2>
    {
      authorPosts.length > 0 ? (
        <ul class="flex flex-col gap-4">
          {authorPosts
            .filter((post) => !post.data.draft)
            .map((post) => (
              <li>
                <BlogCard entry={post} />
              </li>
            ))}
        </ul>
      ) : (
        <p class="text-muted-foreground">
          No posts available from this author.
        </p>
      )
    }
  </section>
</Layout>
