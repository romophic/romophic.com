<div id="comments-section" class="mt-10">
  <div id="comments" class="giscus"></div>
</div>

<script>
  import {
    GISCUS_IFRAME_ORIGIN,
    GISCUS_SCRIPT_URL,
    giscusEmbedAttributes,
    giscusSetConfigMessage,
    giscusTheme,
  } from '@/lib/giscus'

  const currentTheme = () =>
    giscusTheme(document.documentElement.classList.contains('dark'))

  // Re-inject the official embed after every navigation: astro:page-load runs
  // on first load and after each swap. The script derives the discussion term
  // from location.pathname and reads data-theme when it executes, so mounting
  // it here - when the URL and the swapped DOM are final - is what keeps the
  // thread and the theme correct on client-side navigation. The embed fills
  // the .giscus container (and removes the injected script element).
  document.addEventListener('astro:page-load', () => {
    const container = document.querySelector<HTMLElement>('.giscus')
    if (!container) return
    if (container.querySelector('script, iframe')) return

    const script = document.createElement('script')
    script.src = GISCUS_SCRIPT_URL
    script.async = true
    script.crossOrigin = 'anonymous'
    for (const [key, value] of Object.entries(
      giscusEmbedAttributes(currentTheme()),
    )) {
      script.dataset[key] = value
    }
    container.appendChild(script)
  })

  // Live theme toggles use the documented setConfig message.
  window.addEventListener('theme-change', () => {
    const iframe = document.querySelector<HTMLIFrameElement>(
      'iframe.giscus-frame',
    )
    iframe?.contentWindow?.postMessage(
      giscusSetConfigMessage(currentTheme()),
      GISCUS_IFRAME_ORIGIN,
    )
  })
</script>
