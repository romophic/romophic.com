---
/*
 * Apple Liquid Glass Refraction SVG Filter
 * Provides a physics-based optical distortion (refraction) map for backdrop-filter.
 * Uses low baseFrequency + Gaussian blur + high scale (45) for unmistakable liquid glass light bending.
 */
---

<svg
  id="liquid-glass-svg"
  class="pointer-events-none absolute -left-[9999px] -top-[9999px] h-0 w-0 overflow-hidden"
  aria-hidden="true"
>
  <defs>
    <filter
      id="liquid-glass-refraction"
      x="-20%"
      y="-20%"
      width="140%"
      height="140%"
      color-interpolation-filters="sRGB"
    >
      {/* 1. Generate broad, smooth organic waves (low frequency = fluid glass curves) */}
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.008"
        numOctaves="2"
        result="noise"
      ></feTurbulence>
      {/* 2. Soften the noise texture so light bends like polished crystal instead of jagged noise */}
      <feGaussianBlur
        in="noise"
        stdDeviation="3"
        result="smoothNoise"
      ></feGaussianBlur>
      {/* 3. Apply strong optical displacement (scale=45) for vivid, unmistakable refraction */}
      <feDisplacementMap
        in="SourceGraphic"
        in2="smoothNoise"
        scale="45"
        xChannelSelector="R"
        yChannelSelector="G"
        result="displaced"
      ></feDisplacementMap>
    </filter>
  </defs>
</svg>
