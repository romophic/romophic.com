---
import { Icon } from 'astro-icon/components'
import { getTechBadge } from '@/lib/tech-badges'

interface Props {
  tech: string
  class?: string
}

const { tech, class: className = '' } = Astro.props
const badge = getTechBadge(tech)

const baseClass = "flex items-center justify-center gap-1.5 rounded-full border text-xs font-medium transition-colors"
---

{badge ? (
  <span
    class={`${baseClass} px-2.5 py-0.5 ${badge.colorClass} ${className}`}
  >
    <Icon name={badge.icon} class="size-3" />
    {tech}
  </span>
) : (
  <span 
    class={`${baseClass} px-2.5 py-0.5 bg-primary/5 dark:bg-primary/10 text-primary border-primary/10 dark:border-primary/20 ${className}`}
  >
    {tech}
  </span>
)}
