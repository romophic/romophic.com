---
import { getButtonStyles } from '@/components/button.astro'
import { ICONS } from '@/consts'
import { Icon } from 'astro-icon/components'
---

<section class="relative overflow-hidden py-12 sm:py-16">
  <div
    class="animate-in fade-in slide-in-from-bottom-4 flex flex-col items-center gap-y-6 text-center duration-1000"
  >
    <div
      class="border-background relative h-24 w-24 overflow-hidden rounded-[22.5%] border-2 shadow-lg sm:h-32 sm:w-32"
    >
      <img
        src="/favicon.svg"
        alt="romophic avatar"
        class="h-full w-full object-cover"
        width="128"
        height="128"
        fetchpriority="high"
      />
    </div>

    <div class="space-y-2">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        romophic
      </h1>
    </div>

    <div class="flex items-center justify-center pt-2">
      <a
        href="/about"
        class={getButtonStyles({ variant: 'outline', size: 'lg' }) +
          ' rounded-full px-6 shadow-sm transition-all hover:bg-muted'}
      >
        <span class="font-medium">About Me</span>
        <Icon name={ICONS.arrowRight} class="ml-2 size-4" />
      </a>
    </div>
  </div>
</section>
