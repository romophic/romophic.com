---
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro'
import ThemeToggle from '@/components/layout/ThemeToggle.astro'
import { ICONS, NAV_LINKS, SITE } from '@/consts'
import { defaultLang, ui } from '@/i18n/ui'
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils'
import { Icon } from 'astro-icon/components'

type TranslationKey = keyof (typeof ui)[typeof defaultLang]

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div>
  <div
    class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 py-3"
  >
    <a
      href={localizePath('/', lang)}
      class="flex shrink-0 items-center justify-center gap-3"
    >
      <span
        class="hidden h-full text-lg leading-none font-medium min-[400px]:block"
        >{SITE.title}</span
      >
    </a>
    <div class="flex items-center gap-4">
      <nav class="flex items-center gap-4 text-sm sm:gap-6">
        {
          NAV_LINKS.map((item) => (
            <a
              href={localizePath(item.href, lang)}
              class="text-foreground/60 hover:text-foreground capitalize transition-colors"
            >
              {t(`nav.${item.label.toLowerCase()}` as TranslationKey)}
            </a>
          ))
        }
      </nav>
      <button
        class="focus-visible:ring-ring hover:bg-accent hover:text-accent-foreground inline-flex h-9 w-9 items-center justify-center rounded-md px-0 py-2 font-medium transition-colors focus-visible:ring-1 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-50"
        onclick="window.toggleCommandMenu()"
        aria-label="Open Command Menu"
      >
        <Icon name={ICONS.search} class="size-5" />
        <span class="sr-only">{t('search.placeholder')}</span>
      </button>
      <LanguageSwitcher />
      <ThemeToggle />
    </div>
  </div>
</div>
