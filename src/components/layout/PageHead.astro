---
import { SITE } from '@/consts'
import type { CollectionEntry } from 'astro:content'
import type { Article, BreadcrumbList, WithContext } from 'schema-dts'

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  post?: CollectionEntry<'blog'>
}

const {
  post,
  noindex = false,
  title: propTitle,
  description: propDescription,
  image: propImage,
} = Astro.props

const title = post?.data.title || propTitle || SITE.title
const description = post?.data.description || propDescription || SITE.description
const defaultImage = new URL('/static/1200x630.png', Astro.site)
const author =
  post?.data.authors && post.data.authors.length > 0
    ? post.data.authors.map(a => a.id).join(', ')
    : SITE.author

const ogImage = propImage
  ? new URL(propImage, Astro.site)
  : post?.data?.image?.src
    ? `${SITE.href}${post.data.image.src}`
    : defaultImage

const canonicalURL = new URL(Astro.url.pathname, Astro.site)



let articleSchema: WithContext<Article> | null = null
let breadcrumbSchema: WithContext<BreadcrumbList> | null = null

if (post) {
  articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: description,
    image: ogImage.toString(),
    author: post.data.authors?.map((authorRef) => ({
      '@type': 'Person',
      name: authorRef.id,
    })) || [{ '@type': 'Person', name: SITE.author }],
    datePublished: post.data.date.toISOString(),
    dateModified: post.data.date.toISOString(),
  }

  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: Astro.site?.toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: new URL('/blog', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: title,
        item: Astro.url.toString(),
      },
    ],
  }
}
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content={post ? "article" : "website"} />
<meta property="og:locale" content="ja_JP" />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={Astro.url} />
{post && <meta property="og:author" content={author} />}

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
{post && <meta name="twitter:creator" content={author} />}

{
  post?.data.tags &&
    post.data.tags.map((tag: string) => {
      return <meta property="article:tag" content={tag} />
    })
}

{
  articleSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(articleSchema)}
    />
  )
}
{
  breadcrumbSchema && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  )
}
