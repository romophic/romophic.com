---
import { getButtonStyles } from '@/components/ui/button.astro'
import { getLangFromUrl } from '@/i18n/utils'

const currentLang = getLangFromUrl(Astro.url)
const targetLang = currentLang === 'ja' ? 'en' : 'ja'

function getTargetUrl() {
  const path = Astro.url.pathname
  if (currentLang === 'en') {
    // Remove /en prefix
    return path.replace(/^\/en/, '') || '/'
  } else {
    // Add /en prefix
    return `/en${path === '/' ? '' : path}`
  }
}
---

<a
  href={getTargetUrl()}
  class={getButtonStyles({ variant: 'ghost', size: 'sm' }) +
    ' -my-2 -me-2 flex gap-1 px-3 py-2 leading-none'}
  title={targetLang === 'ja' ? 'Switch to Japanese' : 'Switch to English'}
  aria-label="Switch language"
>
  <span
    class={`text-[11px] font-bold uppercase transition-colors ${currentLang === 'ja' ? 'text-foreground' : 'text-muted-foreground/60'}`}
    >ja</span
  >
  <span class="text-muted-foreground/40 text-[11px] font-bold uppercase">/</span
  >
  <span
    class={`text-[11px] font-bold uppercase transition-colors ${currentLang === 'en' ? 'text-foreground' : 'text-muted-foreground/60'}`}
    >en</span
  >
</a>
