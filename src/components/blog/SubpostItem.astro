---
import { Icon } from 'astro-icon/components'

type Props = {
  title: string
  href: string
  readingTime?: string | null
  combinedReadingTime?: string | null
  isActive: boolean
  icon: string
  activeIcon: string
  activeClassName?: string
  linkClassName?: string
}

const {
  title,
  href,
  readingTime,
  combinedReadingTime,
  isActive,
  icon,
  activeIcon,
  activeClassName = '',
  linkClassName = '',
} = Astro.props
---

{
  isActive ? (
    <div
      class:list={[
        'text-foreground bg-muted flex items-center gap-2 rounded-md px-2 py-1.5 text-sm font-medium text-pretty',
        activeClassName,
      ]}
    >
      <Icon name={activeIcon} class="size-4 flex-shrink-0" aria-hidden="true" />
      <div class="flex flex-col">
        <span class="line-clamp-2 text-pretty">{title}</span>
        {readingTime && (
          <span class="text-muted-foreground/80 text-xs">
            {readingTime}
            {combinedReadingTime && combinedReadingTime !== readingTime && (
              <span> ({combinedReadingTime} total)</span>
            )}
          </span>
        )}
      </div>
    </div>
  ) : (
    <a
      href={href}
      class:list={[
        'hover:text-foreground text-muted-foreground hover:bg-muted/50 flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-pretty transition-colors',
        linkClassName,
      ]}
    >
      <Icon name={icon} class="size-4 flex-shrink-0" aria-hidden="true" />
      <div class="flex flex-col">
        <span class="line-clamp-2 text-pretty">{title}</span>
        {readingTime && (
          <span class="text-muted-foreground/80 text-xs">
            {readingTime}
            {combinedReadingTime && combinedReadingTime !== readingTime && (
              <span> ({combinedReadingTime} total)</span>
            )}
          </span>
        )}
      </div>
    </a>
  )
}
