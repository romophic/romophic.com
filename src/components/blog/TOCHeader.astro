---
import { ICONS } from '@/consts'
import type { MarkdownHeading } from 'astro'
import { Icon } from 'astro-icon/components'

type Props = { headings: MarkdownHeading[] }
const { headings } = Astro.props
---

<div
  class="bg-background/80 group sticky top-14 z-40 w-full border-b backdrop-blur-md md:hidden"
>
  <details
    class="[&>summary::marker]:hidden"
    id="mobile-toc-details"
    data-toc-details
  >
    <summary
      class="flex h-12 cursor-pointer items-center justify-between px-4 outline-none"
    >
      <div class="flex items-center gap-2 overflow-hidden">
        <svg class="h-4 w-4" viewBox="0 0 24 24">
          <circle
            class="text-primary/20"
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"></circle>
          <circle
            id="mobile-toc-progress-circle"
            class="text-primary"
            cx="12"
            cy="12"
            r="10"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-dasharray="62.83"
            stroke-dashoffset="62.83"
            transform="rotate(-90 12 12)"></circle>
        </svg>

        <span
          id="mobile-toc-current-section"
          class="text-muted-foreground flex-grow truncate text-sm"
        >
          Overview
        </span>
      </div>
      <span class="text-muted-foreground ml-2">
        <Icon
          name={ICONS.chevronDown}
          class="h-4 w-4 transition-transform duration-200 group-open:rotate-180"
        />
      </span>
    </summary>
    <div
      class="mx-auto max-w-3xl overflow-x-hidden overflow-y-auto"
      data-toc-header-scroll
    >
      <div class="max-h-[30vh]">
        <ul
          class="flex list-none flex-col gap-y-2 px-4 pb-4"
          id="mobile-table-of-contents"
        >
          {
            headings.map((heading: MarkdownHeading) => (
              <li
                class={`text-sm tracking-wide ${
                  heading.depth === 2
                    ? 'text-foreground mt-4 font-semibold'
                    : 'text-muted-foreground ml-3'
                }`}
              >
                {' '}
                <a
                  href={`#${heading.slug}`}
                  class="mobile-toc-item underline decoration-transparent underline-offset-[3px] transition-colors duration-200 hover:decoration-inherit"
                  data-heading-id={heading.slug}
                >
                  {' '}
                  {heading.text}{' '}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <script>
      import {
        buildHeadingRegions,
        getVisibleHeadingIds,
        headingIdsChanged,
        updateScrollMaskClasses,
        type HeadingRegion,
      } from '@/lib/toc-core'

      const INITIAL_OVERVIEW_TEXT = 'Overview'
      const HEADER_OFFSET = 102 + 36
      const PROGRESS_CIRCLE_RADIUS = 10
      const PROGRESS_CIRCLE_CIRCUMFERENCE = 2 * Math.PI * PROGRESS_CIRCLE_RADIUS

      class MobileTOC extends HTMLElement {
        private progressCircle: HTMLElement | null = null
        private currentSectionText: HTMLElement | null = null
        private detailsElement: HTMLDetailsElement | null = null
        private listElement: HTMLElement | null = null
        private scrollArea: HTMLElement | null = null

        private headings: HTMLElement[] = []
        private regions: HeadingRegion[] = []
        private activeIds: string[] = []

        constructor() {
          super()
          this.handleScroll = this.handleScroll.bind(this)
          this.handleResize = this.handleResize.bind(this)
          this.updateProgressCircle = this.updateProgressCircle.bind(this)
          this.updateScrollMask = this.updateScrollMask.bind(this)
        }

        connectedCallback() {
          this.init()
        }

        disconnectedCallback() {
          window.removeEventListener('scroll', this.handleScroll)
          window.removeEventListener('resize', this.handleResize)
          if (this.scrollArea) {
            this.scrollArea.removeEventListener('scroll', this.updateScrollMask)
          }
        }

        init() {
          const result = buildHeadingRegions()
          this.headings = result.headings
          this.regions = result.regions

          if (this.headings.length === 0) {
            this.updateProgressCircle()
            return
          }

          this.activeIds = getVisibleHeadingIds(
            this.headings,
            this.regions,
            HEADER_OFFSET,
          )
          this.updateLinks(this.activeIds)
          this.updateProgressCircle()
          this.setupInteraction()
        }

        handleScroll() {
          const newActiveIds = getVisibleHeadingIds(
            this.headings,
            this.regions,
            HEADER_OFFSET,
          )

          if (headingIdsChanged(this.activeIds, newActiveIds)) {
            this.activeIds = newActiveIds
            this.updateLinks(this.activeIds)
          }

          this.updateProgressCircle()
        }

        handleResize() {
          const result = buildHeadingRegions()
          this.headings = result.headings
          this.regions = result.regions

          const newActiveIds = getVisibleHeadingIds(
            this.headings,
            this.regions,
            HEADER_OFFSET,
          )

          if (headingIdsChanged(this.activeIds, newActiveIds)) {
            this.activeIds = newActiveIds
            this.updateLinks(this.activeIds)
          }
        }

        updateLinks(headingIds: string[]) {
          const items = this.querySelectorAll('.toc-link')

          items.forEach((item) => {
            const tocItem = item as HTMLElement
            const headingId = tocItem.dataset.headingId

            if (headingId && headingIds.includes(headingId)) {
              tocItem.classList.add('text-foreground')
            } else {
              tocItem.classList.remove('text-foreground')
            }
          })

          if (headingIds.length > 0) {
            this.updateCurrentSectionText(headingIds)
            this.scrollToActive(headingIds[0])
          } else {
            let textToShow = INITIAL_OVERVIEW_TEXT
            if (headingIds.length > 0) {
              const activeTexts = headingIds
                .map((id) => this.headings.find((h) => h.id === id))
                .filter((heading) => heading !== undefined)
                .map((heading) => heading.textContent!.trim())

              if (activeTexts.length > 0) {
                textToShow = activeTexts.join(', ')
              }
            }
            this.currentSectionText!.textContent = textToShow
          }
        }

        scrollToActive(activeHeadingId: string) {
          if (!this.scrollArea) return
          const activeItem = this.listElement!.querySelector(
            `[data-heading-id="${activeHeadingId}"]`,
          )
          if (!activeItem) return

          const item = activeItem as HTMLElement
          this.scrollToCenter(this.scrollArea, item)
        }

        updateScrollMask() {
          if (!this.scrollArea) return
          updateScrollMaskClasses(this.scrollArea, this.scrollArea, {
            topClass: 'mask-t-from-80%',
            bottomClass: 'mask-b-from-80%',
          })
        }

        updateProgressCircle() {
          if (!this.progressCircle) return
          const scrollProgress =
            document.documentElement.scrollTop || document.body.scrollTop
          const scrollableDistance =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight

          const progress =
            scrollableDistance > 0
              ? Math.min(Math.max(scrollProgress / scrollableDistance, 0), 1)
              : 0
          this.progressCircle.style.strokeDashoffset = (
            PROGRESS_CIRCLE_CIRCUMFERENCE -
            progress * PROGRESS_CIRCLE_CIRCUMFERENCE
          ).toString()
        }

        setupInteraction() {
          this.progressCircle = this.querySelector(
            '#mobile-toc-progress-circle',
          )
          this.currentSectionText = this.querySelector(
            '#mobile-toc-current-section',
          )
          this.detailsElement = this.querySelector('details')
          this.listElement = this.querySelector('#mobile-table-of-contents')
          this.scrollArea = this.querySelector('[data-toc-header-scroll]')

          if (this.progressCircle) {
            this.progressCircle.style.strokeDasharray =
              PROGRESS_CIRCLE_CIRCUMFERENCE.toString()
            this.progressCircle.style.strokeDashoffset =
              PROGRESS_CIRCLE_CIRCUMFERENCE.toString()
          }

          window.addEventListener('scroll', this.handleScroll, {
            passive: true,
          })
          window.addEventListener('resize', this.handleResize, {
            passive: true,
          })

          this.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
              if (this.detailsElement) {
                this.detailsElement.open = false
              }
            })
          })

          if (this.scrollArea) {
            this.updateScrollMask()
            this.scrollArea.addEventListener('scroll', this.updateScrollMask, {
              passive: true,
            })
          }
        }

        scrollToCenter(container: HTMLElement, target: HTMLElement) {
          const containerRect = container.getBoundingClientRect()
          const targetRect = target.getBoundingClientRect()

          const targetStyle = window.getComputedStyle(target)
          const marginTop = parseFloat(targetStyle.marginTop) || 0
          const marginBottom = parseFloat(targetStyle.marginBottom) || 0
          const actualTargetHeight =
            targetRect.height + marginTop + marginBottom

          const scrollTop =
            target.offsetTop -
            marginTop -
            containerRect.height / 2 +
            actualTargetHeight / 2

          container.scrollTo({
            top: Math.max(0, scrollTop),
            behavior: 'smooth',
          })
        }

        updateCurrentSectionText(headingIds: string[]) {
          if (!this.currentSectionText) return

          if (headingIds.length === 0) {
            this.currentSectionText.textContent = INITIAL_OVERVIEW_TEXT
            return
          }

          const activeTexts = headingIds
            .map((id) => this.headings.find((h) => h.id === id))
            .filter((heading) => heading !== undefined)
            .map((heading) => heading!.textContent!.trim())

          if (activeTexts.length > 0) {
            this.currentSectionText.textContent = activeTexts.join(', ')
          }
        }
      }

      customElements.define('mobile-toc', MobileTOC)
    </script>
  </details>
</div>
