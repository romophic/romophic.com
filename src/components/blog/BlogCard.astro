---
import Separator from '@/components/common/separator.astro'
import { ICONS } from '@/consts'
import {
  getCombinedReadingTime,
  getSubpostCount,
  isSubpost,
  parseAuthors,
} from '@/lib/data-utils'
import { formatDate } from '@/lib/utils'
import { Icon } from 'astro-icon/components'
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
  entry: CollectionEntry<'blog'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.date)
const readTime = await getCombinedReadingTime(entry.id)
const authors = await parseAuthors(entry.data.authors ?? [])
const subpostCount = !isSubpost(entry.id) ? await getSubpostCount(entry.id) : 0
---

<div
  class="group hover:border-primary/50 relative overflow-hidden rounded-xl border p-4 transition-all duration-300 hover:shadow-[0_0_30px_-5px_var(--color-primary)]/10"
>
  <div
    class="from-primary/0 via-primary/0 to-primary/0 group-hover:from-primary/5 absolute inset-0 -z-10 bg-gradient-to-br opacity-0 transition-opacity duration-500 group-hover:to-purple-500/5 group-hover:opacity-100"
  >
  </div>
  <a
    href={`/${entry.collection}/${entry.id}`}
    class="flex flex-col gap-4 sm:flex-row"
  >
    {
      entry.data.image && (
        <div class="w-full overflow-hidden rounded-lg sm:max-w-3xs sm:shrink-0">
          <Image
            src={entry.data.image}
            alt={entry.data.title}
            width={1200}
            height={630}
            class="object-cover transition-transform duration-500 group-hover:scale-105"
            transition:name={`image-${entry.id}`}
          />
        </div>
      )
    }

    <div class="grow">
      <h3 class="mb-1 text-lg font-medium">{entry.data.title}</h3>
      <p class="text-muted-foreground mb-2 text-sm">{entry.data.description}</p>

      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 text-xs"
      >
        {
          authors.length > 0 && (
            <>
              {authors.map((author) => (
                <div class="flex items-center gap-x-1.5">
                  <span>{author.name}</span>
                </div>
              ))}
              <Separator orientation="vertical" class="h-4!" />
            </>
          )
        }
        <span>{formattedDate}</span>
        <Separator orientation="vertical" class="h-4!" />
        <span>{readTime}</span>
        {
          subpostCount > 0 && (
            <>
              <Separator orientation="vertical" class="h-4!" />
              <span class="flex items-center gap-1">
                <Icon name={ICONS.fileText} class="size-3" />
                {subpostCount} subpost{subpostCount === 1 ? '' : 's'}
              </span>
            </>
          )
        }
      </div>

      {
        entry.data.tags && (
          <div class="flex flex-wrap gap-2">
            {entry.data.tags.map((tag) => (
              <div class="border-primary/20 bg-primary/10 text-primary hover:bg-primary/20 flex items-center gap-x-1 rounded-full border px-2.5 py-0.5 text-xs font-semibold transition-colors">
                <Icon name={ICONS.hash} class="size-3" />
                {tag}
              </div>
            ))}
          </div>
        )
      }
    </div>
  </a>
</div>
