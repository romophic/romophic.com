---
import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'
import { Image } from 'astro:assets'

interface Props extends Omit<HTMLAttributes<'img'>, 'src'> {
  src: string | ImageMetadata
  alt?: string
}

const { alt, src, class: className, ...props } = Astro.props

const isLocalImage = typeof src === 'object' && src !== null
---

<figure class="my-8 flex flex-col items-center justify-center gap-0.5">
  {
    isLocalImage ? (
      <Image
        src={src as ImageMetadata}
        alt={alt || ''}
        class={`!m-0 rounded-xl border ${className || ''}`}
        {...(props as Record<string, unknown>)}
      />
    ) : (
      <img
        src={src as string}
        alt={alt || ''}
        class={`!m-0 rounded-xl border ${className || ''}`}
        {...(props as Record<string, unknown>)}
      />
    )
  }
  {
    alt && (
      <figcaption class="text-muted-foreground text-center text-sm font-medium">
        {alt}
      </figcaption>
    )
  }
</figure>
