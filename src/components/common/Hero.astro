---
import { getButtonStyles } from '@/components/common/button.astro'
import { ICONS } from '@/consts'
import { Icon } from 'astro-icon/components'
---

<section class="py-12 sm:py-16">
  <div class="flex flex-col items-start gap-y-6">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      Hello, I'm romophic.
    </h1>
    <p class="text-muted-foreground max-w-2xl text-lg sm:text-xl">
      A developer passionate about algorithms, competitive programming, and
      software engineering. I build digital gardens to document my journey and
      share knowledge.
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="/blog" class={getButtonStyles({ size: 'lg' })}>
        Read Blog
        <Icon name={ICONS.arrowRight} class="ml-2 size-4" />
      </a>
      <a
        href="https://github.com/romophic"
        class={getButtonStyles({ variant: 'outline', size: 'lg' })}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name={ICONS.github} class="mr-2 size-4" />
        GitHub
      </a>
    </div>
  </div>
</section>
