---
import { getButtonStyles } from '@/components/common/button.astro'
import { ICONS, SITE, SOCIAL_LINKS } from '@/consts'
import { getLangFromUrl, localizePath, useTranslations } from '@/i18n/utils'
import { Icon } from 'astro-icon/components'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const githubLink = SOCIAL_LINKS.find((s) => s.label === 'GitHub')
---

<section class="py-12 sm:py-16">
  <div class="flex flex-col items-start gap-y-6">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
      {t('hero.title', { author: SITE.author })}
    </h1>
    <p class="text-muted-foreground max-w-2xl text-lg sm:text-xl">
      {t('hero.subtitle')}
    </p>
    <div class="flex flex-wrap gap-4">
      <a
        href={localizePath('/blog', lang)}
        class={getButtonStyles({ size: 'lg' })}
      >
        {t('hero.readBlog')}
        <Icon name={ICONS.arrowRight} class="ml-2 size-4" />
      </a>
      {
        githubLink && (
          <a
            href={githubLink.href}
            class={getButtonStyles({ variant: 'outline', size: 'lg' })}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icon name={ICONS.github} class="mr-2 size-4" />
            {githubLink.label}
          </a>
        )
      }
    </div>
  </div>
</section>
