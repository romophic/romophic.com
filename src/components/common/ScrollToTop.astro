---
import { getButtonStyles } from '@/components/common/button.astro'
import { ICONS } from '@/consts'
import { Icon } from 'astro-icon/components'

const SCROLL_TO_TOP_THRESHOLD = 300
---

<button
  id="scroll-to-top"
  title="Scroll to top"
  aria-label="Scroll to top"
  class={`${getButtonStyles({ variant: 'outline', size: 'icon' })} fixed bottom-8 right-8 z-50 rounded-full opacity-0 shadow-md transition-all duration-300 hover:-translate-y-1`}
>
  <Icon
    name={ICONS.arrowUp}
    class="mx-auto size-4 transition-all hover:-translate-y-0.5"
  />
</button>

<script is:inline define:vars={{ SCROLL_TO_TOP_THRESHOLD }}>
  ;(function () {
    let handleScroll = null
    let handleClick = null

    document.addEventListener('astro:page-load', () => {
      const btn = document.getElementById('scroll-to-top')
      const footer = document.querySelector('footer')
      if (!btn || !footer) return

      if (handleScroll) window.removeEventListener('scroll', handleScroll)
      if (handleClick) btn.removeEventListener('click', handleClick)

      handleClick = () => window.scrollTo({ top: 0, behavior: 'smooth' })
      handleScroll = () => {
        const isFooterVisible =
          footer.getBoundingClientRect().top <= window.innerHeight
        btn.classList.toggle(
          'hidden',
          window.scrollY <= SCROLL_TO_TOP_THRESHOLD || isFooterVisible,
        )
      }

      btn.addEventListener('click', handleClick)
      window.addEventListener('scroll', handleScroll, { passive: true })
    })
  })()
</script>
