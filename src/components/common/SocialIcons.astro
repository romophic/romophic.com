---
import { getButtonStyles } from '@/components/ui/button.astro'
import { ICON_MAP, ICONS } from '@/consts'
import type { SocialLink } from '@/types'
import { Icon } from 'astro-icon/components'

interface Props {
  links: SocialLink[]
}

const { links } = Astro.props
---

<ul class="flex flex-wrap gap-2" role="list">
  {
    links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          aria-label={label}
          title={label}
          class={getButtonStyles({ variant: 'outline', size: 'icon' })}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon
            name={
              ICON_MAP[label as keyof typeof ICON_MAP] ||
              ICONS.messageCircleQuestion
            }
            class="size-4"
          />
        </a>
      </li>
    ))
  }
</ul>
