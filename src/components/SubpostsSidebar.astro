---
import { ICONS } from '@/consts'
import { getSubpostsData } from '@/lib/data-utils'
import SubpostItem from './SubpostItem.astro'

interface Props {
  parentId: string
}

const { parentId } = Astro.props
const currentPostId = Astro.params.id as string

const {
  activePost,
  isActivePost,
  activePostReadingTime,
  activePostCombinedReadingTime,
  subpostsWithReadingTime,
} = await getSubpostsData(parentId, currentPostId)
---

<div
  id="subposts-sidebar-container"
  class="sticky top-20 col-start-3 row-span-1 mr-auto ml-8 hidden h-[calc(100vh-5rem)] max-w-md xl:block"
>
  <div
    class="flex max-h-[calc(100vh-8rem)] flex-col overflow-y-auto"
    data-subposts-sidebar-scroll
  >
    <div class="px-4">
      <ul class="space-y-1">
        {
          activePost && (
            <li>
              <SubpostItem
                title={activePost.data.title}
                href={`/blog/${activePost.id}#post-title`}
                readingTime={activePostReadingTime}
                combinedReadingTime={activePostCombinedReadingTime}
                isActive={isActivePost}
                icon={ICONS.bookOpen}
                activeIcon={ICONS.bookOpenText}
                activeClassName="subposts-sidebar-active-item pr-3 pl-2"
                linkClassName="subposts-sidebar-link"
              />
            </li>
          )
        }

        {
          subpostsWithReadingTime.length > 0 && (
            <li class="ml-4 space-y-1">
              {subpostsWithReadingTime.map((subpost) => (
                <SubpostItem
                  title={subpost.data.title}
                  href={`/blog/${subpost.id}`}
                  readingTime={subpost.readingTime}
                  isActive={currentPostId === subpost.id}
                  icon={ICONS.file}
                  activeIcon={ICONS.fileText}
                  activeClassName="subposts-sidebar-active-item"
                  linkClassName="subposts-sidebar-link"
                />
              ))}
            </li>
          )
        }
      </ul>
    </div>
  </div>
</div>

<script>
  import { updateScrollMaskClasses, scrollToCenter } from '@/lib/scroll-utils'

  let scrollArea: HTMLElement | null = null

  function init() {
    const sidebarContainer = document.getElementById('subposts-sidebar-container')
    if (!sidebarContainer) return

    scrollArea = sidebarContainer.querySelector('[data-subposts-sidebar-scroll]')
    if (scrollArea) {
      scrollArea.addEventListener('scroll', updateMask, { passive: true })
    }

    requestAnimationFrame(() => {
      toActive()
      setTimeout(updateMask, 100)
    })
  }

  function cleanup() {
    scrollArea?.removeEventListener('scroll', updateMask)
    scrollArea = null
  }

  function updateMask() {
    if (!scrollArea) return
    updateScrollMaskClasses(scrollArea, scrollArea)
  }

  function toActive() {
    if (!scrollArea) return
    const activeItem = scrollArea.querySelector('.subposts-sidebar-active-item')
    if (!activeItem) return
    scrollToCenter(scrollArea, activeItem as HTMLElement)
  }

  document.addEventListener('astro:page-load', init)
  document.addEventListener('astro:before-swap', cleanup)
  document.addEventListener('astro:after-swap', init)
</script>

