---
// Imported with `?inline` on purpose: a plain CSS import gets merged into the
// shared stylesheet chunk and then loads on pages without any math. The inline
// <style> keeps KaTeX CSS on hasMathContent pages only.
import katexCss from 'katex/dist/katex.min.css?inline'

const katexStyleTag = `<style>${katexCss}</style>`
---

<Fragment set:html={katexStyleTag} />
