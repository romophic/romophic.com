---
import PageHead from '@/components/PageHead.astro'
import { getButtonStyles } from '@/components/Button.astro'
import Layout from '@/layouts/Layout.astro'
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="404" />

  <section
    class="flex flex-col items-center justify-center gap-y-6 py-24 text-center"
  >
    <div class="space-y-4">
      <h1
        class="text-muted-foreground/20 text-9xl font-extrabold tracking-tighter"
      >
        404
      </h1>
      <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">
        Page not found
      </h2>
      <p class="text-muted-foreground mx-auto max-w-md">
        Sorry, we couldn't find the page you're looking for. It might have been
        moved, deleted, or never existed in the first place.
      </p>
    </div>
    <div class="flex gap-4">
      <a href="/" class={`${getButtonStyles()} flex gap-x-2`}> Go Home </a>
      <a
        href="/blog"
        class={`${getButtonStyles({ variant: 'outline' })} flex gap-x-2`}
      >
        Go Back to Blog
      </a>
    </div>
  </section>
</Layout>
