---
import BlogPost from '@/components/pages/BlogPost.astro'
import { getAllPostsAndSubposts } from '@/lib/data-utils'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths() {
  const jaPosts = await getAllPostsAndSubposts('ja')
  const enPosts = await getAllPostsAndSubposts('en')

  const jaPaths = jaPosts.map((post) => ({
    params: { lang: undefined, id: post.id },
    props: post,
  }))

  const enPaths = enPosts.map((post) => {
    return {
      params: { lang: 'en', id: post.id },
      props: post,
    }
  })

  return [...jaPaths, ...enPaths]
}

const post = Astro.props as CollectionEntry<'blog'>
---

<BlogPost post={post} />
