---
import BlogList from '@/components/pages/BlogList.astro'
import { SITE } from '@/consts'
import { getAllPosts } from '@/lib/data-utils'
import type { Page, PaginateFunction } from 'astro'
import type { CollectionEntry } from 'astro:content'

export async function getStaticPaths({
  paginate,
}: {
  paginate: PaginateFunction
}) {
  const jaPosts = await getAllPosts('ja')
  const enPosts = await getAllPosts('en')

  const jaPaths = paginate(jaPosts, {
    pageSize: SITE.postsPerPage,
    params: { lang: undefined },
  })

  const enPaths = paginate(enPosts, {
    pageSize: SITE.postsPerPage,
    params: { lang: 'en' },
  })

  return [...jaPaths, ...enPaths]
}

const { page } = Astro.props
---

<BlogList page={page as Page<CollectionEntry<'blog'>>} />
