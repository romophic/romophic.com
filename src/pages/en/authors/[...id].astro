---
import AuthorDetail from '@/components/pages/AuthorDetail.astro'
import { getAllAuthors, getPostsByAuthor } from '@/lib/data-utils'

export async function getStaticPaths() {
  const authors = await getAllAuthors()
  return authors.map((author) => ({
    params: { id: author.id },
    props: { author },
  }))
}

const { author } = Astro.props
const authorPosts = await getPostsByAuthor(author.id, 'en')
---

<AuthorDetail author={author} authorPosts={authorPosts} />
