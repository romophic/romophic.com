---
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import ScrollProgress from '@/components/ScrollProgress.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<BaseLayout bodyClass="flex h-fit min-h-screen flex-col gap-y-6 font-sans">
  <slot name="head" slot="head" />

  <ScrollProgress />
  <header
    class="bg-background/50 sticky top-0 z-50 divide-y backdrop-blur-sm xl:divide-none"
  >
    <Header />
    <slot name="subposts-navigation" />
    <slot name="table-of-contents" />
  </header>
  <main class="mx-auto flex w-full grow flex-col" data-pagefind-body>
    <div class={`flex flex-col gap-y-6 w-full mx-auto px-4 ${className || ''}`}>
      <slot />
    </div>
  </main>
  <Footer />
</BaseLayout>
